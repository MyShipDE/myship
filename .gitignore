!/apps/server/storage/*/.gitkeep
*.Secret
*.Fingerprint

# --- Logs ---
*.log
npm-debug.log*
yarn-error.log

# --- iOS / Capacitor (generated) ---
apps/client/ios/App/App/public/
apps/client/ios/App/Pods/
apps/client/ios/App/build/
DerivedData/

