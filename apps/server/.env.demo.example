# MyShip gateway — DEMO configuration.
# A self-contained virtual vessel: no real hardware, no external services,
# no API keys. For development and App-Store review on a VM/Docker.
#
#   cp .env.demo.example .env   (then: build + start)

# Arms demo mode: demo actuators, seeded virtual fleet, simulated SignalK
# stream on SIGNALK_PORT, Shelly status over MQTT, and auth pass-through.
DEMO_MODE=true

HTTP_HOST=0.0.0.0
HTTP_PORT=80

# MQTT broker (aedes) — TCP + WebSocket(8883). The simulator publishes Shelly
# status here; the app subscribes over ws://<host>:8883.
MQTT_PORT=1883

# The gateway's own demo SignalK stream binds to this host:port, and both the
# gateway and the app consume it. Keep host local; port is the stream port.
SIGNALK_HOST=127.0.0.1
SIGNALK_PORT=3000
RESTART_SIGNALK=false

# SQLite is used when no MYSQL_* is set. Leave empty for the default location;
# the virtual fleet is seeded automatically on first run (empty DB).
SQLITE_PATH=

DEBUG=true
APP_ENV=production

# Camera RTSP streams, comma-separated (served via GET /cameras). Empty in demo.
CAMERA_STREAMS=

# Map provider (served via GET /map/config). Empty key → OSM fallback.
MAPTILER_KEY=
MAPTILER_STYLE=streets-v2

# Not needed in demo (SMTP/SMS/Cloud/WeatherKit/Whisper are neutralised), kept
# here only to document the full set:
# SMTP_HOST= / SMTP_USER= / SMTP_PASS= / SMTP_PORT= / SMTP_ADDR=
# LED_POWERSUPLY_ID=
